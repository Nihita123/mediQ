# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/mediq
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/mediq?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/mediq

# ─── Authentication ───────────────────────────────────────────────────────────
# Use a long random string in production (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slashes.
# Development:  http://localhost:5173
# Production:   https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ─── Rate Limiting (optional — defaults shown) ────────────────────────────────
# Window in milliseconds, max requests per window per IP
# RATE_LOGIN_WINDOW_MS=900000       # 15 minutes
# RATE_LOGIN_MAX=10
# RATE_REGISTER_WINDOW_MS=3600000   # 1 hour
# RATE_REGISTER_MAX=5
# RATE_TRIAGE_START_WINDOW_MS=3600000
# RATE_TRIAGE_START_MAX=10
# RATE_TRIAGE_MSG_WINDOW_MS=60000   # 1 minute
# RATE_TRIAGE_MSG_MAX=20

# ─── LLM Provider Configuration ───────────────────────────────────────────────
# Set ONE of the following blocks to enable AI-powered triage.
# If none are set, the system falls back to rule-based logic automatically.

# Provider selector (optional — auto-detected from available keys if not set)
# Values: openai | gemini | ollama
# LLM_PROVIDER=openai

# LLM request timeout in milliseconds (default: 45000)
# LLM_TIMEOUT_MS=45000

# ── OpenAI ────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash

# ── Ollama (local) ────────────────────────────────────────────────────────────
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

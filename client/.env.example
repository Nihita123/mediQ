# ─── API Configuration ────────────────────────────────────────────────────────
# Development: leave unset or set to http://localhost:5000/api
#              The Vite dev server proxies /api to localhost:5000 automatically.
# Production:  Set to your deployed backend URL.
#              Example: https://mediq-api.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# ─── App Info ─────────────────────────────────────────────────────────────────
VITE_APP_NAME=MediQ
VITE_APP_VERSION=1.0.0
